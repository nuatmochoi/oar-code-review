{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": ["matches", "duplicates"],
  "properties": {
    "matches": {
      "type": "array",
      "maxItems": 5,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["prediction_index", "gold_id", "reason"],
        "properties": {
          "prediction_index": {"type": "integer", "minimum": 0},
          "gold_id": {"type": "string"},
          "reason": {"type": "string"}
        }
      }
    },
    "duplicates": {
      "type": "array",
      "maxItems": 5,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["prediction_index", "gold_id", "reason"],
        "properties": {
          "prediction_index": {"type": "integer", "minimum": 0},
          "gold_id": {"type": "string"},
          "reason": {"type": "string"}
        }
      }
    }
  }
}
